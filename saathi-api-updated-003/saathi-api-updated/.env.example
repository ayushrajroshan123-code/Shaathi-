# ==============================================================================
# SAATHI Backend Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL)
# Local development example: postgres://postgres:password@localhost:5432/saathi
# Managed cloud example: postgres://app_user:placeholder_password@db.provider.internal:5432/saathi
DATABASE_URL=postgres://postgres:placeholder_password@localhost:5432/saathi

# Database TLS / SSL Configuration (Optional)
# Supported values: true, false, require, verify-ca, verify-full, disable
# Set to 'require' or 'true' for managed cloud databases (AWS RDS, Neon, Supabase, Cloud SQL)
# Leave unset or set to 'false' for local development plain TCP connections.
DATABASE_SSL=false

# Certificate verification opt-out (Optional; defaults to true)
# Only set to 'false' if explicitly using self-signed certificates without a custom CA.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Custom CA Certificate (Optional)
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL_CA_PATH=/path/to/custom-ca-certificate.pem

# Connection & Pool Timeouts (in milliseconds)
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_MAX_POOL_SIZE=10
DATABASE_IDLE_TIMEOUT_MS=10000

# Health & Readiness Probe Timeout (in milliseconds)
DB_READINESS_TIMEOUT_MS=2000

# Graceful Shutdown Timeout (in milliseconds)
SHUTDOWN_TIMEOUT_MS=10000

# CORS Allowed Origins (Comma-separated list of exact HTTP/HTTPS origins)
# Required in production (NODE_ENV=production). Wildcards are strictly rejected.
# Local development default: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication Session Duration (in days, defaults to 30)
SESSION_TTL_DAYS=30

# Feature Flags
# Phase boundary: emergency routes exist for later phases and are gated behind an opt-in flag.
# Set to 'true' only when emergency routes are explicitly enabled. Defaults to false.
ENABLE_EMERGENCY_ROUTES=false

# ==============================================================================
# Portfolio Demo Environment Configuration (Optional; Demo Tooling Only)
# Used strictly by scripts/seed_demo.js and scripts/reset_demo.js for isolated portfolio demos.
#
# SECURITY REQUIREMENTS:
# 1. Environment checks are an operational guard, NOT a substitute for PostgreSQL permissions.
# 2. The demo database role (EXPECTED_DEMO_ROLE) MUST be dedicated and least-privileged:
#    - NOSUPERUSER, NOCREATEDB, NOCREATEROLE, NOREPLICATION.
#    - NO permissions, grants, or connect privileges on production or development databases ('saathi', 'saathi_test').
# 3. Demo operations are refused unless all four variables below are explicitly configured:
# DEMO_MODE=false
# ALLOW_DEMO_RESET=false
# EXPECTED_DEMO_DB_NAME=saathi_demo
# EXPECTED_DEMO_ROLE=saathi_demo_user
# ==============================================================================
