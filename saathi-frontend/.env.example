# ==============================================================================
# SAATHI Frontend Environment Configuration (.env.example)
# Copy this file to .env or .env.local for development, or .env.production for release builds.
#
# NOTE: All VITE_* variables are bundled into the compiled client JavaScript assets
# and are PUBLICLY VISIBLE to all website visitors.
# NEVER place database passwords, private API keys, or secrets in this file.
# ==============================================================================

# Backend API Base URL (Required for production builds; defaults to http://localhost:3000 in dev)
# Local development: http://localhost:3000
# Production example: https://api.saathi.community
VITE_API_BASE_URL=https://api.saathi.community

# Demo Mode Isolation Flag (Optional; Defaults to false)
# When set to 'true', enables convenience shortcuts on LoginView for fictional personas
# and shows visible "Fictional Demo Data" banners.
# When unset or 'false', all shortcuts are hidden, login credentials start blank,
# and authenticated sessions strictly display real backend API data.
# MUST BE FALSE OR UNSET IN NORMAL PRODUCTION DEPLOYMENTS.
#
# NOTE ON DEMO CREDENTIALS:
# Demo persona prefill credentials (e.g. *.demo@saathi.local / DemoSecret123!) are public conveniences.
# They are verified strictly by the server and MUST exist ONLY within the isolated demo database ('saathi_demo').
# Real-user production environments MUST NEVER accept or seed these fictional accounts.
VITE_DEMO_MODE=false

